#include <stdio.h>
#include <stdlib.h>

void fill_array(int *arr, int n) {
    for (int i = 0; i < n; i++) arr[i] = i * 10;
}

int main() {
    int n = 5;
    int *arr = (int *)malloc(n * sizeof(int));

    fill_array(arr, n);

    for (int i = 0; i < n; i++) printf("%d ", arr[i]);
    printf("\n");

    free(arr);
    return 0;
}

Output:

0 10 20 30 40
