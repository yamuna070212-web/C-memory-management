#include <stdio.h>
#include <stdlib.h>

int main() {
    int n = 10;

    // GOOD: sizeof(*p) adapts automatically to type of p
    int *p = (int *)malloc(n * sizeof(*p));
    if (p == NULL) return 1;

    for (int i = 0; i < n; i++) p[i] = i;
    printf("p[5] = %d\n", p[5]);

    free(p);
    return 0;
}

Output:

p[5] = 5
