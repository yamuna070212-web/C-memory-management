#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    char *buffer = (char *)malloc(10);
    strcpy(buffer, "Hi");

    strcat(buffer, " there"); // still fits in 10 bytes

    char *bigger = (char *)realloc(buffer, 50);
    if (bigger == NULL) {
        free(buffer);
        return 1;
    }
    buffer = bigger;
    strcat(buffer, ", this string just grew!");

    printf("%s\n", buffer);
    free(buffer);
    return 0;
}

Output:

Hi there, this string just grew!
