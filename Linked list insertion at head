#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node;

Node *insert_head(Node *head, int value) {
    Node *node = (Node *)malloc(sizeof(Node));
    node->data = value;
    node->next = head;
    return node;
}

int main() {
    Node *head = NULL;
    head = insert_head(head, 3);
    head = insert_head(head, 2);
    head = insert_head(head, 1);

    for (Node *cur = head; cur != NULL; cur = cur->next)
        printf("%d ", cur->data);
    printf("\n");

    // cleanup omitted here intentionally, see next example
    Node *cur = head;
    while (cur != NULL) {
        Node *next = cur->next;
        free(cur);
        cur = next;
    }
    return 0;
}

Output:

1 2 3
