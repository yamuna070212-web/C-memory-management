#include <stdio.h>
#include <stdlib.h>

#define POOL_SIZE 5

typedef struct {
    int blocks[POOL_SIZE];
    int used[POOL_SIZE];
} MemoryPool;

int pool_alloc(MemoryPool *pool) {
    for (int i = 0; i < POOL_SIZE; i++) {
        if (!pool->used[i]) {
            pool->used[i] = 1;
            return i;
        }
    }
    return -1; // pool full
}

void pool_free(MemoryPool *pool, int index) {
    if (index >= 0 && index < POOL_SIZE) pool->used[index] = 0;
}

int main() {
    MemoryPool pool = {0};
    int idx1 = pool_alloc(&pool);
    pool.blocks[idx1] = 100;
    printf("Allocated block %d with value %d\n", idx1, pool.blocks[idx1]);

    pool_free(&pool, idx1);
    return 0;
}

