#include <stdio.h>
#include <stdlib.h>

int main() {
    int *a = (int *)malloc(5 * sizeof(int));  // uninitialized (garbage values)
    int *b = (int *)calloc(5, sizeof(int));   // zero-initialized

    printf("malloc values (may be garbage): ");
    for (int i = 0; i < 5; i++) printf("%d ", a[i]);
    printf("\n");

    printf("calloc values (guaranteed zero): ");
    for (int i = 0; i < 5; i++) printf("%d ", b[i]);
    printf("\n");

    free(a);
    free(b);
    return 0;
}

Output:

malloc values (may be garbage): 0 0 0 0 0 
calloc values (guaranteed zero): 0 0 0 0 0
