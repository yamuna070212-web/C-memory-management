#include <stdio.h>
#include <stdlib.h>

int main() {
    int *arr = (int *)malloc(5 * sizeof(int));
    for (int i = 0; i < 5; i++) arr[i] = i;

    int *temp = (int *)realloc(arr, 10 * sizeof(int));
    if (temp == NULL) {
        printf("Realloc failed, original block still valid\n");
        free(arr); // original pointer still valid, must free it
        return 1;
    }
    arr = temp; // only reassign on success

    for (int i = 5; i < 10; i++) arr[i] = i;
    printf("Resized successfully\n");

    free(arr);
    return 0;
}

Output:

Resized successfully
