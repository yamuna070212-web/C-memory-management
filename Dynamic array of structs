#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int id;
    char name[20];
} Employee;

int main() {
    int n = 3;
    Employee *emp = (Employee *)malloc(n * sizeof(Employee));
    if (emp == NULL) return 1;

    for (int i = 0; i < n; i++) {
        emp[i].id = i + 1;
        snprintf(emp[i].name, 20, "Emp%d", i + 1);
    }

    for (int i = 0; i < n; i++)
        printf("%d: %s\n", emp[i].id, emp[i].name);

    free(emp);
    return 0;
}

