#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    const char *source = "Hello, Memory!";
    char *str = (char *)malloc(strlen(source) + 1);
    if (str == NULL) return 1;

    strcpy(str, source);
    printf("%s\n", str);

    free(str);
    return 0;
}

Output:

Hello, Memory!
